// Cloudflare Workers の静的アセット配信。Worker スクリプトはなく、site/ をそのまま置く。
// 手順: ./zailoop build --years 2024,2025 --out site && npx wrangler deploy
{
  "name": "zailoop",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./site",
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
